Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.3
      Style: Spheres
      Color: 255; 255; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Vehicles
      Enabled: true
      Topic:
        Value: /sim/markers
        Depth: 5
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 60
      Focal Point:
        X: 30
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.14
Window Geometry:
  Height: 800
  Width: 1200
